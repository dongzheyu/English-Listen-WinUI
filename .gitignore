## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache
.vs/
Generated\ Files/

# Test and profiler output
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml
*.coverage
*.coveragexml
*.dotCover
OpenCover/

# Compiler and build artifacts
*.obj
*.pdb
*.ipdb
*.pgd
*.ilk
*.binlog
*.cachefile
*.rsp
artifacts/
publish/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# IDE/project tooling
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
.localhistory/
.ionide/
.cr/personal
node_modules/

# Publishing and signing
*.pubxml
*.publishproj
PublishScripts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.publishsettings
*.pfx

# Generated/source conversion output
Generated_Code/
MigrationBackup/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# Local data and caches
config/secret.json
config/settings.json
config/redeem_codes.json
config/*.dat
cache/

# Development certificate
devcert.pfx
